# Template for gravatar-job.development-secrets.env (GITIGNORED — copy this file, drop the
# .example suffix, fill in real values). Needed so the job can mirror found gravatars into R2;
# without these it falls back to existence-probing only.

# Object storage (Cloudflare R2; all four required or storage stays disabled).
# Endpoint: https://{account_id}.r2.cloudflarestorage.com   Region: auto (default)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
