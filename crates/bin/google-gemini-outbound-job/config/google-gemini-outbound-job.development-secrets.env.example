# Template for google-gemini-outbound-job.development-secrets.env (GITIGNORED — copy this file, drop the
# .example suffix, fill in real values). Never commit real secrets.

# Google Gemini API key — REQUIRED (this worker exists to talk to Google).
GEMINI_API_KEY=

# Object storage (Cloudflare R2; all four required or storage stays disabled and
# output ingest fails). Endpoint: https://{account_id}.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# The bucket's PUBLIC base URL (input CDN fetches resolve against stored paths).
CDN_BASE_URL=
