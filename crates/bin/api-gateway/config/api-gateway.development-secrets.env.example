# Template for api-gateway.development-secrets.env (which is GITIGNORED — copy this file,
# drop the .example suffix, and fill in real values).
#
#   cp api-gateway.development-secrets.env.example api-gateway.development-secrets.env
#
# Never commit real secrets.

# Outbound email (Resend). With a real key set, also set EMAIL_FROM_ADDRESS to a
# Resend-verified sender (overrides the development.env default), e.g.:
#   EMAIL_FROM_ADDRESS="Foundation <noreply@yourdomain.com>"
RESEND_API_KEY=

# Provider credentials (blank = that provider is unroutable, not an error).
KINOVI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Object storage (Cloudflare R2; all four required or storage stays disabled).
# Endpoint: https://{account_id}.r2.cloudflarestorage.com   Region: auto (default)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# REQUIRED with R2: the bucket's PUBLIC base URL — asset links (avatars) are served from here.
# R2 dashboard → your bucket → Settings → Public access → enable the r2.dev subdomain, then:
#   CDN_BASE_URL=https://pub-<hash>.r2.dev
# (Overrides the local-minio default in api-gateway.development.env; a missing scheme is
# auto-corrected, but include https:// anyway.)
CDN_BASE_URL=
