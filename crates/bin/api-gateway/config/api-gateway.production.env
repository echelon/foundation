# api-gateway — production. Committed: config only, NEVER real secrets.
# Secrets (DATABASE_URL, SESSION_SECRET, RESEND_API_KEY, provider keys) are injected as real
# environment variables at deploy time — process env always wins over these files.

FOUNDATION_ENV=production

COOKIE_DOMAIN=.foundation.ai
COOKIE_SECURE=true

APP_BASE_URL=https://foundation.ai
CDN_BASE_URL=https://cdn.foundation.ai

EMAIL_FROM_ADDRESS="Foundation <noreply@foundation.ai>"
