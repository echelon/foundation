# api-gateway — local development defaults. Committed: NO real secrets in this file
# (those go in api-gateway.development-secrets.env, which is gitignored).

FOUNDATION_ENV=dev
DATABASE_URL=postgres://foundation:foundation@localhost:5432/foundation_development

# Sessions/cookies — plain http locally, so no Secure attribute.
SESSION_SECRET=dev-insecure-session-secret-change-me
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# The Vite dev server — emailed links (password reset) point here.
APP_BASE_URL=http://localhost:3000

# Object store / CDN base. This minio default is a LAST RESORT — when using R2 locally, set
# CDN_BASE_URL to the bucket's public URL (https://pub-<hash>.r2.dev) in the secrets file,
# which loads first and wins.
CDN_BASE_URL=http://localhost:9000/foundation

# Outbound email. Sender must be a Resend-verified domain to actually deliver;
# with no RESEND_API_KEY (see the secrets file) sends are logged and skipped.
#EMAIL_FROM_ADDRESS="Foundation <noreply@localhost>"

# Operator status/downtime notice, surfaced verbatim by GET /v1/api_status for frontend
# banners. Unset/blank = all quiet. Set at deploy (or here, to test the banner):
# API_STATUS_MESSAGE=Scheduled maintenance 03:00-03:30 UTC - logins may be flaky.

# "Sign in with Google" (GIS ID-token flow). The client ID is PUBLIC — no client secret
# exists in this flow. Must match the frontend's VITE_GOOGLE_CLIENT_ID; unset = SSO off.
# Obtain: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# TODO(bt,2026-07-21): TEMPORARY client ID borrowed from another project — replace with a
# fresh OAuth client created for this product's real domain before launch.
GOOGLE_CLIENT_ID=788843034237-b1314stpq8h74ntlo3jivdusudik9ged.apps.googleusercontent.com

# "Sign in with GitHub" (web application flow). The Client ID is public; the CLIENT SECRET is
# NOT — it lives in api-gateway.development-secrets.env (gitignored) / deploy env. Both must
# be set or GitHub SSO stays off. Must match the frontend's VITE_GITHUB_CLIENT_ID.
GITHUB_CLIENT_ID=Iv23liFJOCYJvNqvVIwx
