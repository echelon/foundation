{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_API_BASE_URL=/ VITE_TOKENCRAFT_DEMO=true npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://tokencraft-demo.onrender.com/v1/:path*"
    },
    {
      "source": "/ready",
      "destination": "https://tokencraft-demo.onrender.com/ready"
    },
    {
      "source": "/design",
      "destination": "/design/index.html"
    },
    {
      "source": "/design/",
      "destination": "/design/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
